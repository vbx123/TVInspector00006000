<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" android:minHeight="140dp" android:orientation="vertical"
    android:padding="20dp" android:background="@drawable/bg_card"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tvIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="38sp" />
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text" android:textSize="24sp"
        android:textStyle="bold" android:textAlignment="viewStart" android:textDirection="firstStrong" />
    <TextView android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="17sp"
        android:textAlignment="viewStart" android:textDirection="firstStrong" />
</LinearLayout>
