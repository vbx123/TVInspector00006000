<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical"
    android:background="@drawable/bg_main" android:padding="32dp">

    <TextView
        android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TV DEVICE INSPECTOR" android:textColor="@color/sky" android:textSize="40sp"
        android:textStyle="bold" android:textAlignment="viewStart" android:textDirection="ltr" />
    <TextView
        android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="أداة تحليل وفحص أجهزة Android TV" android:textColor="@color/muted"
        android:textSize="22sp" android:textAlignment="viewStart" android:textDirection="firstStrong" />
    <TextView
        android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/text" android:textSize="20sp"
        android:textAlignment="viewStart" android:textDirection="firstStrong" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button
            android:id="@+id/btnScan" android:layout_width="400dp" android:layout_height="84dp"
            android:background="@drawable/bg_button" android:focusable="true"
            android:text="ابدأ الفحص الشامل" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
            android:stateListAnimator="@null" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="32dp" android:orientation="vertical">
            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="الحالة: جاهز" android:textColor="@color/text" android:textSize="22sp"
                android:textAlignment="viewStart" android:textDirection="firstStrong" />
            <TextView android:id="@+id/tvTests" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="الاختبارات المنفذة: 0" android:textColor="@color/muted" android:textSize="20sp"
                android:textAlignment="viewStart" android:textDirection="firstStrong" />
            <TextView android:id="@+id/tvPercent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="التقدم: 0%" android:textColor="@color/muted" android:textSize="20sp"
                android:textAlignment="viewStart" android:textDirection="firstStrong" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="16dp"
        android:max="100" android:progress="0" android:progressTint="@color/sky" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dashboard" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp" android:clipToPadding="false"
        android:visibility="gone" />
</LinearLayout>
