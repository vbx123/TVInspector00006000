<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical"
    android:background="@drawable/bg_main" android:padding="32dp">
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" android:textColor="@color/sky" android:textSize="32sp"
        android:textStyle="bold" android:textAlignment="viewStart" android:textDirection="firstStrong" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" />
    <Button android:id="@+id/btnAction" android:layout_width="match_parent" android:layout_height="72dp"
        android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:focusable="true"
        android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="22sp"
        android:stateListAnimator="@null" android:visibility="gone" />
</LinearLayout>
